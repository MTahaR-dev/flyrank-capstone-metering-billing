# Copy to .env and fill in real values. .env is git-ignored and must never be committed.
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env

# --- Database ---
POSTGRES_USER=billing
POSTGRES_PASSWORD=change-me
POSTGRES_DB=billing

# Host "localhost" when running the app directly; docker-compose overrides this to "db".
DATABASE_URL=postgresql://billing:change-me@localhost:5432/billing

# --- Stripe (test mode only) ---
# Dashboard -> Developers -> API keys. Test keys begin with sk_test_.
STRIPE_SECRET_KEY=sk_test_your_test_key

# Printed by `stripe listen --forward-to localhost:8000/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Price ID of the Pro subscription created in the Stripe test dashboard.
STRIPE_PRO_PRICE_ID=price_your_pro_price_id

# Where Stripe returns the customer after Checkout.
CHECKOUT_SUCCESS_URL=http://localhost:8000/billing/success
CHECKOUT_CANCEL_URL=http://localhost:8000/billing/cancel
